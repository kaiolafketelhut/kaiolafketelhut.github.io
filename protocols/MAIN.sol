// MAIN.sol - OMQ - BLAK FAT12 - sol<pattern>omq
pragma solidity ^0.8.20;
contract MAIN { string public name="OMQ - PROTOCOLS - BLAK FAT12"; string public pattern="sol<pattern>omq"; uint public total=12;
struct Point{string slug;string title;string desc;string code;} Point[] public points;
constructor(){points.push(Point("http","HTTP","Hypertext Transfer Protocol - Loads web pages","HTTP = Loads web pages"));points.push(Point("https","HTTPS","Hypertext Transfer Protocol Secure - Encrypts web","HTTPS = Encrypts web traffic"));points.push(Point("ftp","FTP","File Transfer Protocol - Transfers files","FTP = Transfers files"));points.push(Point("tcp","TCP","Transmission Control Protocol - Reliable ordered","TCP = Reliable ordered delivery"));points.push(Point("udp","UDP","User Datagram Protocol - Fast no guarantee","UDP = Fast datagrams"));points.push(Point("ip","IP","Internet Protocol - Addresses routes packets","IP = Addresses routes packets"));points.push(Point("smtp","SMTP","Simple Mail Transfer Protocol - Sends email","SMTP = Sends email"));points.push(Point("pop3","POP3","Post Office Protocol v3 - Downloads email","POP3 = Downloads email"));points.push(Point("imap","IMAP","Internet Message Access Protocol - Syncs email","IMAP = Syncs email server"));points.push(Point("dns","DNS","Domain Name System - Resolves domain to IP","DNS = Domain to IP"));points.push(Point("dhcp","DHCP","Dynamic Host Configuration Protocol - Assigns IP","DHCP = Assigns IP settings"));points.push(Point("ssh","SSH + Telnet + SNMP","Secure Shell - Encrypted login - SNMP monitors","SSH = Encrypted login"));} function getPoint(uint i) public view returns(Point memory){return points[i];} }
